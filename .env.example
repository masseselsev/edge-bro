POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=borg_orchestrator
REDIS_URL=redis://redis:6379/0
BORG_PASSPHRASE=your_secure_borg_passphrase
DATABASE_URL=postgresql://postgres:your_secure_db_password@db:5432/borg_orchestrator
ORCHESTRATOR_IP=192.168.1.10  # IP address of the orchestrator, accessible by edge nodes
# Storage. Two independent locations — each takes a Docker named volume (the
# defaults below) or an absolute host path. Keep them separate: the backup path
# holds borg repositories and the ISO cache should not sit among them. To put
# both on one drive, use sibling directories:
#   BORG_HOST_DATA_PATH=/mnt/nfs/edge-bro
#   ISO_CACHE_HOST_PATH=/mnt/nfs/iso_cache
BORG_HOST_DATA_PATH=borg-data  # Backup repositories
ISO_CACHE_HOST_PATH=iso-cache  # Base + client ISO cache (needs ~20 GB free)
# Subnet for the stack's own Docker network. Change it only if it clashes with
# something this host already routes -- a VPN, a tunnel, another Docker
# network. A clash is silent and total: containers keep talking to each other
# while every published port stops answering, including the one nodes push
# backups to. Check with `ip route` before picking a replacement.
# Applying a change needs the stack stopped: docker compose down && up -d
# DOCKER_SUBNET=172.29.13.0/24
# SSH stability (optional, defaults shown)
# SSH_KEEPALIVE_INTERVAL=30    # Seconds between keepalive packets
# SSH_KEEPALIVE_COUNT=3        # Missed responses before disconnect
# Authentication Configuration
SUPERADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_superadmin_password
JWT_SECRET_KEY=your_secure_jwt_secret_key_change_me
# Telegram delivery for the alert notification system (optional). Leave
# unset to disable Telegram delivery fleet-wide — the UI shows delivery as
# "not configured" rather than letting anyone enable a path that cannot
# work. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Scale tuning -----------------------------------------------------------
# Celery worker pool sizes. The two pools are separate so a multi-hour backup
# cannot delay the 60-second scheduler tick.
CELERY_BACKUP_CONCURRENCY=8
CELERY_PERIODIC_CONCURRENCY=4

# SQLAlchemy pool, per process. Celery prefork gives each child its own pool,
# so keep (workers x children x (size + overflow)) under Postgres max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Concurrent `ping` subprocesses in the reachability sweep.
PING_CONCURRENCY=64

# How long log tables are kept, in days.
SYSTEM_LOG_RETENTION_DAYS=14
AUDIT_LOG_RETENTION_DAYS=365

# --- Fleet prune (backup_tasks.global_daily_prune) ---
# Run the nightly prune in decide-only mode: it logs every archive it would
# delete and deletes nothing. Worth one night on a real fleet before trusting
# the retention port in core/retention.py.
BORG_PRUNE_DRY_RUN=
# Archives per `borg delete` invocation. Keeps argv under ARG_MAX and makes a
# partial failure legible.
BORG_DELETE_BATCH=200
# How long the repository-maintenance flag survives without a heartbeat. Bounds
# how long backups stand down after a worker is killed mid-prune.
BORG_MAINTENANCE_TTL=900

# --- Repository sharding ----------------------------------------------------
# How many independent borg repositories the fleet is spread over. Borg holds a
# repository's lock for the whole of `borg create`, so one repository means one
# node backing up at a time no matter what a group's concurrency_limit says;
# each shard is another genuinely parallel writer.
#
# Shard 0 is the pre-existing /data/borg/fleet, so 1 is the layout that
# predates sharding, exactly. Small deployments can sit there.
#
# This can be RAISED on a running fleet and cannot be LOWERED. A node's shard is
# stored at enrolment, not recomputed, so adding shards leaves existing nodes
# where their archives are and only routes new enrolments to the new
# repositories; the SSH grants are derived from this number and the
# orchestrator rewrites them itself on startup, so raising it needs no extra
# step. Lowering is floored by the repositories already on disk — the fleet
# keeps serving them and startup says the setting was overridden.
#
# Size by peak concurrency, not fleet size. Backup groups already spread the
# fleet across weeks and months, so nightly volume is small by design. What a
# shard caps is parallel writers: borg holds the repository lock for the whole
# of `borg create`, so however many a group permits, one shard runs one at a
# time — the scheduler caps its own dispatch at this number rather than queuing
# backups that cannot start.
#
# Default 1: the pre-sharding layout, and enough for any fleet that spreads its
# backups. Raise it to the largest concurrency_limit you actually want to
# achieve. The case that most wants more is onboarding, where every node's
# expensive first backup falls due at once.
BORG_SHARD_COUNT=1
# How long any borg command waits for a repository lock before giving up —
# create, init, list, delete, compact, export-tar. Borg's own default is one
# second, which fails an operation that should simply have queued behind
# another on the same shard.
BORG_LOCK_WAIT_SECONDS=600
# How long a running backup stays registered as a writer of its repository
# without a heartbeat. That registration is what stops the next node's
# pre-flight from breaking the lock out from under a live transfer, so it has
# to outlast the longest backup you expect; it is refreshed every minute while
# data is moving, so this only bounds the silence after a worker is killed.
BORG_WRITER_TTL=14400

# --- Networking -------------------------------------------------------------
# DNS servers the containers use. SITE_DNS is the resolver for this
# installation's internal names. Leave it as-is and containers simply have no
# internal resolver, which is the right default for a deployment that does not
# need one; set it to your site's resolver if node hostnames must resolve.
UPSTREAM_DNS=8.8.8.8
SITE_DNS=192.168.1.1

# Browser origins allowed to make credentialed API calls. Leave empty to allow
# any private-network address (localhost, 10/8, 192.168/16, 172.16-31/12) on
# any port, which is what a LAN deployment reached by IP needs. Set a
# comma-separated list to pin it exactly, e.g.
# CORS_ALLOWED_ORIGINS=http://192.168.1.10:7777

# --- Updating without a local build ------------------------------------------
# Every GitHub release publishes ready-to-run images to ghcr.io. Pin this to a
# released version (e.g. 1.7.12, no "v") and `docker compose pull && docker
# compose up -d` runs that exact release with no local build. Bump it by hand
# Pin the release image tag to run. The release workflow publishes images
# tagged with each release version (e.g. 1.8.0). Pinning it keeps a deployment
# stable until you choose to change it; to upgrade, update this tag and run:
#   docker compose pull && docker compose up -d
EDGE_BRO_IMAGE_TAG=1.8.2
CORS_ALLOWED_ORIGINS=
